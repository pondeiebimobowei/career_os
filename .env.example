# ==============================================================================
# CareerOS Environment Configuration (.env.example)
# Copy this file to .env before starting development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Node / Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# Database & Persistence (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Local development default using PostgreSQL container/service
DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros?schema=public

# ------------------------------------------------------------------------------
# Authentication (NestJS JWT & Social OAuth2)
# ------------------------------------------------------------------------------
JWT_SECRET=dev_jwt_secret_change_in_production_32bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ------------------------------------------------------------------------------
# Storage & Object Services (Cloudflare R2 / AWS S3 Compatible)
# ------------------------------------------------------------------------------
STORAGE_BUCKET=careeros-dev-storage
STORAGE_ACCESS_KEY_ID=dev_access_key
STORAGE_SECRET_ACCESS_KEY=dev_secret_key
STORAGE_ENDPOINT=http://localhost:9000

# ------------------------------------------------------------------------------
# Observability & Monitoring
# ------------------------------------------------------------------------------
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
POSTHOG_API_KEY=phc_dev_dummy_key
POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# AI & Analytics Integrations (Future / Optional)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-dummy-key-for-local-dev
