# API Backend Environment Variables
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://careeros:careeros@localhost:5432/careeros?schema=public

# Authentication (JWT & Social OAuth2)
JWT_SECRET=dev_jwt_secret_change_in_production_32bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Storage
STORAGE_BUCKET=careeros-dev-storage
STORAGE_ACCESS_KEY_ID=dev_access_key
STORAGE_SECRET_ACCESS_KEY=dev_secret_key

# Monitoring
SENTRY_DSN=
POSTHOG_API_KEY=
