{
  "name": "careeros",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "backlog:validate": "pnpm --filter @repo/backlog-cli start validate",
    "backlog:sync": "pnpm --filter @repo/backlog-cli start sync",
    "backlog:status": "pnpm --filter @repo/backlog-cli start status",
    "backlog:doctor": "pnpm --filter @repo/backlog-cli start doctor",
    "backlog:graph": "pnpm --filter @repo/backlog-cli start graph",
    "backlog:export": "pnpm --filter @repo/backlog-cli start export",
    "backlog:generate": "pnpm --filter @repo/backlog-cli start generate",
    "backlog:docs": "pnpm --filter @repo/backlog-cli start docs",
    "backlog:next": "pnpm --filter @repo/backlog-cli start next",
    "backlog:start": "pnpm --filter @repo/backlog-cli start start",
    "backlog:pr": "pnpm --filter @repo/backlog-cli start pr",
    "backlog:finish": "pnpm --filter @repo/backlog-cli start finish",
    "backlog:work": "pnpm --filter @repo/backlog-cli start work",
    "backlog:explain": "pnpm --filter @repo/backlog-cli start explain",
    "backlog:ai": "pnpm --filter @repo/backlog-cli start ai",
    "backlog:dashboard": "pnpm --filter @repo/backlog-cli start dashboard",
    "backlog:verify": "pnpm --filter @repo/backlog-cli start verify",
    "backlog:stats": "pnpm --filter @repo/backlog-cli start stats",
    "backlog:version": "pnpm --filter @repo/backlog-cli start version",
    "backlog:setup": "pnpm --filter @repo/backlog-cli start setup",
    "backlog:bootstrap": "pnpm --filter @repo/backlog-cli start setup",
    "backlog:repair": "pnpm --filter @repo/backlog-cli start repair",
    "gate": "pnpm backlog:verify --json && pnpm backlog:sync --dry-run && pnpm check-types && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  }
}
