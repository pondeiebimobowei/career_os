{
  "name": "kitchen-sink",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "backlog:validate": "pnpm --filter @repo/backlog-cli start validate",
    "backlog:sync": "pnpm --filter @repo/backlog-cli start sync",
    "backlog:status": "pnpm --filter @repo/backlog-cli start status",
    "backlog:doctor": "pnpm --filter @repo/backlog-cli start doctor",
    "backlog:graph": "pnpm --filter @repo/backlog-cli start graph",
    "backlog:export": "pnpm --filter @repo/backlog-cli start export",
    "backlog:generate": "pnpm --filter @repo/backlog-cli start generate",
    "backlog:docs": "pnpm --filter @repo/backlog-cli start docs",
    "backlog:next": "pnpm --filter @repo/backlog-cli start next"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=18"
  }
}
